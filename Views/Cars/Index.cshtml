
@model List<CarRental.Models.Car>

@{
    ViewData["Title"] = "Available Cars";
}

<h2 class="fw-bold mb-2">Available Cars</h2>

<p class="text-muted mb-4">
    Select a car from the list below to book it.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No cars are currently available.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var car in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body d-flex flex-column p-4">

                        <h5 class="card-title fw-bold">
                            @car.Name
                        </h5>

                        <p class="card-text text-muted mb-3">
                            PKR @car.PricePerDay.ToString("N0") / day
                        </p>

                        <div class="mb-4">
                            <span class="badge bg-success">
                                Available
                            </span>
                        </div>

                        <form asp-controller="Cars"
                              asp-action="Book"
                              method="post"
                              class="mt-auto">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@car.Id" />

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Book Car
                            </button>

                        </form>

                    </div>
                </div>
            </div>
        }

    </div>
}
